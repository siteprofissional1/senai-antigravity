<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <!-- Definições de Filtros, Gradientes e Efeitos de Luz -->
  <defs>
    <!-- Gradiente de Fundo do Cartão Glassmorphic -->
    <linearGradient id="cardGlassGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="rgba(255, 255, 255, 0.22)" />
      <stop offset="35%" stop-color="rgba(0, 240, 255, 0.08)" />
      <stop offset="70%" stop-color="rgba(112, 0, 255, 0.08)" />
      <stop offset="100%" stop-color="rgba(255, 255, 255, 0.05)" />
    </linearGradient>

    <!-- Borda Neon Ciano/Roxo -->
    <linearGradient id="borderGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00F0FF" stop-opacity="0.8" />
      <stop offset="50%" stop-color="rgba(255, 255, 255, 0.4)" />
      <stop offset="100%" stop-color="#7000FF" stop-opacity="0.8" />
    </linearGradient>

    <!-- Chip Neon Dourado/Ciano -->
    <linearGradient id="chipGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00F0FF" />
      <stop offset="100%" stop-color="#7000FF" />
    </linearGradient>

    <!-- Sombra com Brilho Neon (Glow) -->
    <filter id="glowEffect" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="12" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>

    <!-- Sombra Projetada 3D -->
    <filter id="shadow3D" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="25" stdDeviation="30" flood-color="#000000" flood-opacity="0.7" />
      <feDropShadow dx="0" dy="10" stdDeviation="15" flood-color="#00F0FF" flood-opacity="0.25" />
    </filter>
  </defs>

  <!-- Cartão Base com Sombra e Efeito Glass -->
  <g filter="url(#shadow3D)">
    <!-- Corpo Principal do Cartão -->
    <rect x="40" y="40" width="720" height="420" rx="28" fill="url(#cardGlassGrad)" stroke="url(#borderGrad)" stroke-width="2.5" />

    <!-- Textura de Malha e Circuitos Impressos Holográficos -->
    <g opacity="0.25" stroke="#00F0FF" stroke-width="1.2" fill="none">
      <path d="M40 180 Q 200 120 360 220 T 760 140" />
      <path d="M40 320 Q 300 400 520 280 T 760 380" />
      <!-- Circuitos do Microchip -->
      <path d="M 120 180 L 220 180 L 260 220 L 340 220" />
      <circle cx="340" cy="220" r="4" fill="#00F0FF" />
      <path d="M 220 180 L 220 120 L 280 120" />
      <circle cx="280" cy="120" r="4" fill="#7000FF" />
      <path d="M 120 220 L 180 220 L 210 260 L 310 260" />
      <circle cx="310" cy="260" r="4" fill="#00FF94" />
    </g>

    <!-- Reflexo de Luz Vidro Cristalino (Highlight Superior) -->
    <path d="M 42 42 L 758 42 A 26 26 0 0 1 758 120 L 42 220 Z" fill="rgba(255, 255, 255, 0.12)" />

    <!-- Logo "COFRE TRANSPARENTE" -->
    <g transform="translate(90, 95)">
      <!-- Ícone do Cofre Holográfico -->
      <rect x="0" y="0" width="44" height="44" rx="10" fill="rgba(0, 240, 255, 0.15)" stroke="#00F0FF" stroke-width="2" />
      <circle cx="22" cy="22" r="10" stroke="#00F0FF" stroke-width="2" fill="none" />
      <path d="M22 12 L22 17 M22 27 L22 32 M12 22 L17 22 M27 22 L32 22" stroke="#00F0FF" stroke-width="2" />
      <circle cx="22" cy="22" r="3" fill="#00FF94" />

      <!-- Marca em Texto -->
      <text x="60" y="26" font-family="'Outfit', sans-serif" font-weight="800" font-size="22" fill="#FFFFFF" letter-spacing="2">COFRE</text>
      <text x="60" y="42" font-family="'Outfit', sans-serif" font-weight="300" font-size="12" fill="#00F0FF" letter-spacing="4">TRANSPARENTE</text>
    </g>

    <!-- Símbolo Contactless (NFC) -->
    <g transform="translate(680, 90)" stroke="#00F0FF" stroke-width="2.5" fill="none" opacity="0.85">
      <path d="M0 0 A 12 12 0 0 1 0 24" />
      <path d="M6 -4 A 18 18 0 0 1 6 28" />
      <path d="M12 -8 A 24 24 0 0 1 12 32" />
    </g>

    <!-- Microchip de Cristal Integrado -->
    <g transform="translate(90, 180)">
      <rect x="0" y="0" width="68" height="52" rx="8" fill="url(#chipGrad)" stroke="#FFFFFF" stroke-opacity="0.5" stroke-width="1.5" filter="url(#glowEffect)" />
      <!-- Linhas internas do Chip -->
      <path d="M 0 17 L 68 17 M 0 34 L 68 34 M 23 0 L 23 52 M 45 0 L 45 52" stroke="rgba(5, 8, 17, 0.4)" stroke-width="1.5" fill="none" />
      <circle cx="34" cy="26" r="6" fill="rgba(255,255,255,0.7)" />
    </g>

    <!-- Número do Cartão Embossado Holográfico -->
    <text x="90" y="300" font-family="'Courier New', monospace" font-weight="bold" font-size="28" fill="#FFFFFF" letter-spacing="4" opacity="0.95" filter="url(#glowEffect)">
      4589 •••• •••• 9920
    </text>

    <!-- Dados do Validador e Titular -->
    <text x="90" y="345" font-family="'Inter', sans-serif" font-size="11" fill="rgba(245, 247, 250, 0.6)" letter-spacing="1.5">VALID THRU</text>
    <text x="90" y="365" font-family="'Courier New', monospace" font-size="16" font-weight="bold" fill="#00F0FF">12/31</text>

    <text x="240" y="345" font-family="'Inter', sans-serif" font-size="11" fill="rgba(245, 247, 250, 0.6)" letter-spacing="1.5">CARDHOLDER</text>
    <text x="240" y="365" font-family="'Outfit', sans-serif" font-weight="600" font-size="16" fill="#FFFFFF" letter-spacing="2">GLOBAL NOMAD / STARTUP</text>

    <!-- Bandeira Holográfica Visa / Mastercard Cyber -->
    <g transform="translate(640, 340)">
      <circle cx="20" cy="20" r="22" fill="#7000FF" opacity="0.75" />
      <circle cx="42" cy="20" r="22" fill="#00F0FF" opacity="0.75" />
      <path d="M 31 3.5 A 22 22 0 0 1 31 36.5 A 22 22 0 0 1 31 3.5 Z" fill="#00FF94" opacity="0.8" />
    </g>
  </g>
</svg>
